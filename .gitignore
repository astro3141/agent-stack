# local interpreters and caches
.venv/
__pycache__/
*.pyc

# MLflow backing store: binary, regenerable, and holds trace content
evidence/mlflow/

# Holds a (revoked) Preloop gateway key and sidecar bearer from the F8 incident.
# Kept on disk as evidence, never versioned.
evidence/incident-20260920/

# scratch
*.tmp

# #281 run evidence (raw ACP events, permission requests)
evidence/p281/

# derived from config/*.yaml by stack/cfg.py
config/generated/
docker/.env

# regenerated by every bring-up, and per machine: two instances rebasing over the same file
# is friction with no record in it (OPERATIONS §33)
evidence/checks/last.json
evidence/ops/host-state.json

# hand-in data belongs to the machine it was handed to, not to the repository
handoff/*
!handoff/README.md


# Declarations and pins for packages this repository does not carry — a private repository, a
# client's workflow. The tracked config/packages.yaml stays a declaration a stranger can run.
config/packages.local.yaml
config/packages.local.lock

# This machine's instance name, ports and paths (scripts/restore.sh writes it)
config/instance.env

# Which project a package runs against — a repository, a branch, a policy path. Instance
# configuration, like config/instance.env: the package's own repository holds the rules, and this
# repository holds neither (docs/packages.md, OPERATIONS §39).
config/*/projects/

# ---------------------------------------------------------------------------------------------
# Two trees are written by runs and by whoever installs things, not by whoever writes this
# repository. Both are ignored by default and carry named exceptions, because listing what is
# private is a list somebody forgets to add to -- and this repository is public (OPERATIONS §42).

# Packages: visible to git only if this repository carries it. A package fetched from its own
# repository, a client's workflow, anything dropped in by hand -- none of it is staged by accident.
packages/*
!packages/hello-lane/
!packages/auto/
!packages/novel/
!packages/research-r/

# Run output: meta, logs, event logs, soak samples, the operator's own records. It is written by
# runs, it grows without bound, and a Conductor workflow_started event carries the whole graph of
# whatever ran -- which is how a package's design ended up in this repository's evidence once
# already. What stays are the hand-written attestations the findings quote.
evidence/*
!evidence/build-281.log
!evidence/container-toolchain.txt
!evidence/hook-invocations.log
!evidence/n1-deny-evidence.txt
!evidence/n1-markers/
!evidence/n7-bypass-inventory.txt
!evidence/n7-network-isolation.txt

# A Windows absolute path that a tool wrote as a relative one, so `C:` became a directory here.
# Junk by construction — and `git add -A` committed 38 files of a package's working copy out of one
# before it was caught (OPERATIONS §59). Ignored so the next mis-quoted path is untracked, not
# published; whatever is inside it belongs to whoever made it, so nothing here deletes it.
/C:/
/[A-Z]:/

# What this instance opened, and for whose package. The providers baseline is tracked
# (docker/egress/allow); an instance's own additions and any profile it provisions are its business,
# and this repository is public — the same split as config/packages.local.yaml (OPERATIONS §60).
# `closed` (baseline only) and `probe` (the platform's own) ship tracked as the shapes to copy.
docker/egress/allow.local
docker/egress/profiles/*.allow
!docker/egress/profiles/closed.allow
!docker/egress/profiles/probe.allow
config/generated/egress/
